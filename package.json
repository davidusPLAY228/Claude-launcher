{
  "name": "claude-launcher",
  "version": "1.2.0",
  "description": "GUI launcher for Claude Code with OmniRoute",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "author": "Hachiba9020",
  "license": "ISC",
  "build": {
    "appId": "com.Hachiba9020.claude-launcher",
    "productName": "Claude Launcher",
    "win": {
      "icon": "manifest.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Claude Launcher",
      "createDesktopShortcut": true
    },
    "files": [
      "**/*",
      "!manifest.png"
    ]
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^26.15.3"
  }
}
